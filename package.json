{
  "name": "solo-languages",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "languages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check:literals": "node tools/literal-check/bin/check-no-language-literals.mjs",
    "check": "npm run check:literals && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
